        "contract": "con_dex",
        "function": "removeLiquidity",
        "kwargs": {
          "tokenA": "con_token_a",
          "tokenB": "con_token_b",
          "liquidity": 10,
          "amountAMin": 9999,
          "amountBMin": 0,
          "to": "alice",
          "deadline": {
            "$datetime": [
              2025,
              10,
              28
            ]
          }
        },
        "error": "INSUFFICIENT_A_AMOUNT"
      },
      {
        "id": "removeLiquidity",
        "contract": "con_dex",
        "function": "removeLiquidity",
        "kwargs": {
          "tokenA": "con_token_a",
          "tokenB": "con_token_b",
          "liquidity": 10,
          "amountAMin": 0,
          "amountBMin": 0,
          "to": "alice",
          "deadline": {
            "$datetime": [
              2025,
              10,
              28
            ]
          }
        }
