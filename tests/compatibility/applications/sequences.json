        }
      },
      {
        "id": "fee_transfer",
        "contract": "con_token",
        "function": "transfer",
        "kwargs": {
          "amount": 100,
          "to": "carol"
        },
        "sender": "bob"
      },
      {
        "id": "balance_of",
        "contract": "con_token",
        "function": "balance_of",
        "kwargs": {
          "address": "carol"
        }
      },
      {
        "id": "get_total_supply",
        "contract": "con_token",
        "function": "get_total_supply",
        "kwargs": {}
