      },
      {
        "id": "change_metadata",
        "contract": "con_token",
        "function": "change_metadata",
        "kwargs": {
          "key": "token_name",
          "value": "Corpus"
        }
      },
      {
        "id": "final_balance",
        "contract": "con_token",
        "function": "balance_of",
        "kwargs": {
          "address": "alice"
        }
      }
