        "function": "swapExactTokenForToken",
        "kwargs": {
          "amountIn": 10,
          "amountOutMin": 0,
          "pair": 1,
          "src": "con_token_a",
          "to": "alice",
          "deadline": {
            "$datetime": [
              2025,
              10,
              28
            ]
          }
        }
      },
      {
