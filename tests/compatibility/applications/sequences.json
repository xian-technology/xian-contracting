        "contract": "con_dex",
        "function": "getAmountsOut",
        "kwargs": {
          "amountIn": 10,
          "src": "con_token_a",
          "path": [
            1
          ]
        }
      },
      {
        "id": "slippage_rejected",
        "contract": "con_dex",
        "function": "swapExactTokenForToken",
        "kwargs": {
          "amountIn": 10,
          "amountOutMin": 999,
          "pair": 1,
          "src": "con_token_a",
          "to": "alice",
          "deadline": {
            "$datetime": [
              2025,
              10,
              28
            ]
          }
        },
        "error": "INSUFFICIENT_OUTPUT_AMOUNT"
