 },
 "source": "@export\ndef appended(n: int):\n    items = []\n    for i in range(n):\n        items.append(i)\n    return [len(items), items[0], items[-1]]\n\n@export\ndef indexed(n: int):\n    items = list(range(n))\n    alias = items\n    total = 0\n    for i in range(n):\n        items[i] = items[i] * 2\n        total += alias[i]\n    items[-1] = 'last'\n    return [total, alias[-1], len(items)]\n\n@export\ndef self_reference():\n    items = [0, 1]\n    items[0] = items\n    return [items[0] is items, len(items[0][0])]\n\n@export\ndef out_of_range():\n    items = [1]\n    items[1] = 2\n\n@export\ndef method_dispatch(n: int):\n    items = list(range(n))\n    count = 0\n    for i in range(n):\n        if items:\n            count += 1\n    return count\n"
}